{
  "name": "functions",
  "description": "Cloud Functions for Gentle",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "set-admin": "npm run build && node lib/scripts/set-admin.js",
    "test:rules": "npx -y firebase-tools@15.33.0 emulators:exec --project demo-gentle-rules --only firestore,storage \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "npm run build && npx -y firebase-tools@15.33.0 emulators:start --project demo-gentle --only auth,firestore,storage,functions",
    "seed": "node dev/seed-emulators.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@googleapis/androidpublisher": "^42.2.0",
    "@sendgrid/mail": "^8.1.6",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.5",
    "firebase": "^13.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
