# Copy to functions/.env.sleeptales-4bac2 and fill in before `firebase deploy`.
# Secrets (keys, webhook secret) do NOT go here: set them with
#   firebase functions:secrets:set <NAME>
# for SENDGRID_API_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
# APPLE_IAP_KEY and APPLE_SIGNIN_KEY (paste the .p8 contents).

# Customer webapp; Stripe sends people back here after checkout.
APP_URL=https://gentle-mu.vercel.app
# Sender for welcome, code and account-deletion mails (verified in SendGrid,
# and registered with Apple's private email relay).
MAIL_FROM=noreply@example.com

# Stripe price ids (Products → Gentle Premium → monthly / yearly price).
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
# true once Stripe Tax has an origin address.
STRIPE_AUTOMATIC_TAX=false

# App Store Connect → Users and Access → Integrations → In-App Purchase key.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_BUNDLE_ID=io.sleeptales.sleeptales

# Sign in with Apple key (Certificates, Identifiers & Profiles → Keys).
APPLE_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_CLIENT_ID=io.sleeptales.sleeptales

ANDROID_PACKAGE=com.mezz.gentle
