rules_version = '2';

// Audio and images are played through download URLs, which carry their own
// token and don't go through these rules. Premium audio tokens are rotated by
// the adminSetTrackPremium function so old URLs stop working.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.token.get('admin', false) == true; }

    // Profile photos: only the owner (and admins) can see or change them.
    match /users/{uid}/{allPaths=**} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
    }

    // Content (tracks, thumbnails, covers): managed by admins.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
