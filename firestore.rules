rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function hasPremium() {
      let path = /databases/$(database)/documents/subscriptions/$(request.auth.uid);
      return signedIn() && exists(path) && get(path).data.active == true
        && (get(path).data.expiresAt == null || get(path).data.expiresAt > request.time);
    }

    // Profile. Users may edit their own profile but never their role.
    function validProfile(data) {
      return data.keys().hasOnly(['id', 'name', 'email', 'createdAt', 'language', 'heardFrom', 'goals', 'photoURL', 'role'])
        && data.get('name', '').size() <= 100
        && data.get('email', '').size() <= 320
        && data.get('photoURL', '').size() <= 2048;
    }
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && validProfile(request.resource.data)
        && (!('role' in request.resource.data) || request.resource.data.role == 'client');
      allow update: if isAdmin() || (isOwner(uid) && validProfile(request.resource.data)
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.get('role', 'client')));
      allow delete: if isAdmin();
    }

    match /favorites/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /favorites_playlists/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Content: readable for signed-in users, editable by admins.
    match /tracks/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /playlists/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /pages/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /blocks/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Audio of premium tracks: only for premium users; written by Cloud Functions.
    match /track_audio/{id} {
      allow read: if hasPremium() || isAdmin();
      allow write: if false;
    }

    // Play counts: anyone signed in may add exactly one play to an existing track; admins read.
    match /track_stats/{trackId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['plays'])
        && request.resource.data.plays == 1
        && exists(/databases/$(database)/documents/tracks/$(trackId));
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['plays'])
        && request.resource.data.plays == resource.data.plays + 1;
    }

    // Activity log: users append their own entries, admins read.
    match /activity_log/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['id', 'title', 'userId', 'subtitle', 'activityType', 'timestamp', 'extra'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && (request.resource.data.get('subtitle', null) == null || request.resource.data.subtitle.size() <= 500)
        && (request.resource.data.get('extra', null) == null || request.resource.data.extra.size() <= 500);
      allow read: if isAdmin();
    }

    // Premium status: written only by Cloud Functions.
    match /subscriptions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // Access codes: never visible to app users; changed only by Cloud Functions.
    match /access_codes/{code} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /code_batches/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /push_jobs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /admin_log/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Everything else (code_attempts, …) is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
